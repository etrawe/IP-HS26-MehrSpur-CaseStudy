    "        \"active\": True,\n",
    "        \"mode\": \"PT\",\n",
    "        \"kind\": \"pt_stop\",\n",
    "        \"station\": \"Forch\",\n",
    "        \"both_directions\": True,\n",
    "        \"crowding_enabled\": True,\n",
    "    })\n",
    "p.SECTION = project_section\n",
    "\n",
    "# Apply the active section to every stage dict the notebook may use.\n",
    "for stage, spec in list(STAGE_SPECS.items()):\n",
    "    spec[\"section_config\"] = project_section\n",
    "if \"EDITED_STAGE_SPECS\" in globals():\n",
