   "source": [
    "# Check the logit probabilities directly using unit demand on every OD pair.\n",
    "mode_choice_module = ctx.modules[\"mode_choice_zurich\"]\n",
    "probability_parameters = mode_choice_module.load_mode_choice_parameters()\n",
    "for parameter_name in probability_parameters:\n",
    "    if parameter_name in stages[0]:\n",
    "        probability_parameters[parameter_name] = stages[0][parameter_name]\n",
    "unit_od = pd.DataFrame(1.0, index=labels, columns=labels)\n",
    "probability_od, _ = mode_choice_module.mode_split_aggregated(\n",
    "    res_stage0.travel_times,\n",
    "    res_stage0.lengths,\n",
    "    unit_od,\n",
    "    walk_allowed_mask=ctx.modules[\"travel_times\"].standalone_walk_mask(\n",
    "        res_stage0.lengths, ctx.zones\n",
    "    ),\n",
    "    parameters=probability_parameters,\n",
    ")\n",
    "probability_stack = np.stack([\n",
    "    probability_od[mode].reindex(index=labels, columns=labels).to_numpy(dtype=float)\n",
    "    for mode in mode_choice_module.MODE_ORDER\n",
    "])\n",
    "probability_sums = probability_stack.sum(axis=0)\n",
    "\n",
    "mode_trip_sum = sum(\n",
    "    frame.reindex(index=labels, columns=labels, fill_value=0).to_numpy(dtype=float)\n",
    "    for frame in res_stage0.od_by_mode.values()\n",
    ")\n",
    "baseline_demand = ctx.baseline_od.reindex(\n",
    "    index=labels, columns=labels, fill_value=0\n",
    ").to_numpy(dtype=float)\n",
    "\n",
    "# Retain internal, inbound and outbound trips exactly; external-to-external\n",
    "# trips are estimated at the corridor's configured pass-through fraction.\n",
    "collapsed_modes = {\n",
    "    mode: tmi.collapse_od_to_gates(\n",
    "        frame, ctx, MEHRSPUR,\n",
    "        passthrough_fraction=tmi.DEFAULT_PASSTHROUGH_FRACTION,\n",
    "    )[0]\n",
    "    for mode, frame in mode_trip_frames.items()\n",
    "}\n",
    "internal_zones = list(MEHRSPUR.zone_ids)\n",
    "gate_ids = MEHRSPUR.gates[\"gate_id\"].astype(str).tolist()\n",
    "category_selections = {\n",
    "    \"Internal (zone to zone)\": (internal_zones, internal_zones),\n",
    "    \"Inbound (gate to zone)\": (gate_ids, internal_zones),\n",
    "    \"Outbound (zone to gate)\": (internal_zones, gate_ids),\n",
    "    \"Pass-through (estimated gate to gate)\": (gate_ids, gate_ids),\n",
    "}\n",
    "category_rows = []\n",
    "for category, (origins, destinations) in category_selections.items():\n",
    "    category_trips = {\n",
    "        mode: float(matrix.loc[origins, destinations].to_numpy(dtype=float).sum())\n",
    "        for mode, matrix in collapsed_modes.items()\n",
    "    }\n",
    "    category_total = sum(category_trips.values())\n",
    "    category_rows.append({\n",
    "        \"Travel category\": category,\n",
    "        \"Trips (peak hour)\": category_total,\n",
    "        **{f\"{mode} share\": value / category_total if category_total else np.nan\n",
    "           for mode, value in category_trips.items()},\n",
    "    })\n",
    "category_split = pd.DataFrame(category_rows)\n",
    "category_total_trips = float(category_split[\"Trips (peak hour)\"].sum())\n",
    "reference_cordon_trips = float(BASELINE_CORDON_BREAKDOWN[\"trips\"].sum())\n",
    "\n",
    "validation_results = {\n",
    "    \"All OD mode probabilities are finite\": bool(np.isfinite(probability_stack).all()),\n",
    "    \"Every mode probability is between 0 and 1\": bool(\n",
    "        (probability_stack >= -1e-12).all() and (probability_stack <= 1 + 1e-12).all()\n",
    "    ),\n",
    "    \"Mode probabilities sum to 1 for every OD pair\": bool(\n",
    "        np.allclose(probability_sums, 1.0, rtol=0, atol=1e-12)\n",
    "    ),\n",
    "    \"Mode trips reconcile to demand in every OD cell\": bool(\n",
    "        np.allclose(mode_trip_sum, baseline_demand, rtol=1e-9, atol=1e-6)\n",
    "    ),\n",
    "    \"Aggregate trip shares sum to 1\": bool(\n",
    "        np.isclose(corridor_split[\"Trip Share\"].sum(), 1.0, atol=1e-12)\n",
    "    ),\n",
    "    \"Aggregate PKM shares sum to 1\": bool(\n",
    "        np.isclose(corridor_split[\"PKM Share\"].sum(), 1.0, atol=1e-12)\n",
    "    ),\n",
    "    \"Cordon categories reconcile to retained baseline demand\": bool(\n",
    "        np.isclose(category_total_trips, reference_cordon_trips, rtol=1e-9, atol=1e-6)\n",
    "    ),\n",
    "}\n",
    "validation_table = pd.DataFrame([\n",
    "    {\"Check\": description, \"Passed\": passed}\n",
    "    for description, passed in validation_results.items()\n",
    "])\n",
    "print(\"Stage-0 model checks\")\n",
    "display(validation_table)\n",
    "if not all(validation_results.values()):\n",
    "    raise AssertionError(\"One or more baseline modal-split validation checks failed.\")\n",
    "\n",
    "print(\n",
    "    f\"Modal probabilities: [{probability_stack.min():.6f}, {probability_stack.max():.6f}], \"\n",
    "    f\"maximum OD sum error {np.max(np.abs(probability_sums - 1.0)):.2e}; \"\n",
    "    f\"maximum demand-reconciliation error {np.max(np.abs(mode_trip_sum - baseline_demand)):.2e}.\"\n",
    ")\n",
    "print(\n",
    "    f\"Cordon totals: {total_corridor_trips:,.0f} trips touch the corridor; \"\n",
    "    f\"{category_total_trips:,.0f} retained trips including estimated pass-through.\"\n",
    ")\n",
    "print(f\"Estimated pass-through fraction: {tmi.DEFAULT_PASSTHROUGH_FRACTION:.1%}.\")\n",
    "display(category_split.style.format({\n",
    "    \"Trips (peak hour)\": \"{:,.0f}\",\n",
    "    **{f\"{mode} share\": \"{:.1%}\" for mode in mode_trip_frames},\n",
    "}))"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "forch-baseline-interpretation",
   "metadata": {},
   "source": [
    "**How to read and validate the baseline**\n",
    "\n",
    "The trip-share and PKM-share tables use the same corridor-touching OD scope. PKM is calculated with each mode's own route-distance skim and includes short positive-distance trips; the PKM shares therefore answer a different question than trip shares. A higher PKM share than trip share indicates that mode tends to carry longer journeys; a lower PKM share indicates that its trips tend to be shorter. The directional OD tables show the same comparison for the named Forch catchment relations.\n",
    "\n",
    "The category check distinguishes internal, inbound, outbound, and estimated pass-through demand. Inbound and outbound are directional. Pass-through is not observed: the corridor model applies its configured 5% estimate only to external OD pairs assigned to different entry/exit gates. Treat it as an assumption, not measured demand.\n",
    "\n",
    "**External validation limitation:** the repository contains the supplied canton-wide transport inputs and mode-choice coefficients, but not the named AP5 Forch Massnahmenblatt, a Forch observed modal-share table, or previous student appraisal reports. The numerical checks below validate model consistency, not realism. Before claiming empirical validation, compare the reported scope/year/peak period and mode definitions with those reference sources and document discrepancies. No `parameters.py` values are changed for this baseline exercise."
   ]
