   "source": [
    "# Stage-0 results for the configured Forch Mobility Hub corridor; no interventions are active.\n",
    "corridor_zone_ids = list(MEHRSPUR.zone_ids)\n",
    "labels = res_stage0.od_by_mode[\"drive\"].index.astype(str)\n",
    "inside_corridor = np.isin(labels, np.asarray(corridor_zone_ids, dtype=str))\n",
    "involved_od = inside_corridor[:, None] | inside_corridor[None, :]\n",
    "\n",
    "# Include short access journeys: the 5 km filter in the MehrSpur example is not used here.\n",
    "MIN_PKM_DISTANCE_KM = 0.0\n",
    "mode_trip_frames = {\n",
    "    \"Car\": res_stage0.od_by_mode[\"drive\"],\n",
    "    \"Public Transport\": res_stage0.od_by_mode[\"pt_walk\"] + res_stage0.od_by_mode[\"pt_bike\"],\n",
    "    \"Cycling\": res_stage0.od_by_mode[\"bike\"],\n",
    "    \"Walking\": res_stage0.od_by_mode[\"walk\"],\n",
    "}\n",
    "mode_distance_components = {\n",
    "    \"Car\": [(res_stage0.od_by_mode[\"drive\"], res_stage0.lengths[\"drive\"])],\n",
    "    \"Public Transport\": [\n",
    "        (res_stage0.od_by_mode[\"pt_walk\"], res_stage0.lengths[\"pt_walk\"]),\n",
    "        (res_stage0.od_by_mode[\"pt_bike\"], res_stage0.lengths[\"pt_bike\"]),\n",
    "    ],\n",
    "    \"Cycling\": [(res_stage0.od_by_mode[\"bike\"], res_stage0.lengths[\"bike\"])],\n",
    "    \"Walking\": [(res_stage0.od_by_mode[\"walk\"], res_stage0.lengths[\"walk\"])],\n",
    "}\n",
    "\n",
    "trip_totals = {}\n",
    "pkm_totals = {}\n",
    "pkm_matrices = {}\n",
    "distance_coverage_trips = {}\n",
    "for mode, trip_frame in mode_trip_frames.items():\n",
    "    trips = trip_frame.reindex(index=labels, columns=labels).to_numpy(dtype=float)\n",
    "    trip_totals[mode] = float(trips[involved_od].sum())\n",
    "    mode_pkm_matrix = np.zeros_like(trips)\n",
    "    for quantity_frame, distance_frame in mode_distance_components[mode]:\n",
    "        quantities = quantity_frame.reindex(index=labels, columns=labels).to_numpy(dtype=float)\n",
    "        distance_km = distance_frame.reindex(index=labels, columns=labels).to_numpy(dtype=float) / 1000.0\n",
    "        positive_trips = quantities > 0\n",
    "        missing_distance = involved_od & positive_trips & ~np.isfinite(distance_km)\n",
    "        distance_coverage_trips[mode] = distance_coverage_trips.get(mode, 0.0) + float(quantities[missing_distance].sum())\n",
    "        eligible = involved_od & positive_trips & np.isfinite(distance_km) & (distance_km >= MIN_PKM_DISTANCE_KM)\n",
    "        mode_pkm_matrix[eligible] += quantities[eligible] * distance_km[eligible]\n",
    "    pkm_matrices[mode] = mode_pkm_matrix\n",
    "    pkm_totals[mode] = float(mode_pkm_matrix.sum())\n",
    "\n",
    "total_corridor_trips = sum(trip_totals.values())\n",
    "total_corridor_pkm = sum(pkm_totals.values())\n",
    "if total_corridor_trips <= 0 or total_corridor_pkm <= 0:\n",
    "    raise ValueError(\"The Stage-0 corridor baseline must contain positive trips and passenger-kilometres.\")\n",
    "\n",
    "corridor_split = pd.DataFrame([\n",
    "    {\n",
    "        \"Mode\": mode,\n",
    "        \"Trips (peak hour)\": trip_totals[mode],\n",
    "        \"Trip Share\": trip_totals[mode] / total_corridor_trips,\n",
    "        \"Trips omitted from PKM (no finite distance)\": distance_coverage_trips.get(mode, 0.0),\n",
    "        \"Passenger-km (peak hour)\": pkm_totals[mode],\n",
    "        \"PKM Share\": pkm_totals[mode] / total_corridor_pkm,\n",
    "    }\n",
    "    for mode in mode_trip_frames\n",
    "])\n",
    "\n",
    "# Compare directions between the project-defined catchment groups and the rest of the canton.\n",
    "key_pairs = [\n",
    "    (\"Mobility Hub Region\", \"Mobility Hub Region\"),\n",
    "    (\"Mobility Hub Region\", \"Southern Switzerland (Gateways)\"),\n",
    "    (\"Southern Switzerland (Gateways)\", \"Mobility Hub Region\"),\n",
    "    (\"Mobility Hub Region\", \"Rest of Canton\"),\n",
    "    (\"Rest of Canton\", \"Mobility Hub Region\"),\n",
    "    (\"Southern Switzerland (Gateways)\", \"Rest of Canton\"),\n",
    "    (\"Rest of Canton\", \"Southern Switzerland (Gateways)\"),\n",
    "]\n",
    "od_trip_split = tmi.corridor_od_summary(\n",
    "    ctx, res_stage0, key_pairs, macro_regions=p.CORRIDOR_REGIONS\n",
    ")\n",
    "municipality_to_region = {\n",
    "    municipality: region\n",
    "    for region, municipalities in p.CORRIDOR_REGIONS.items()\n",
    "    for municipality in municipalities\n",
    "}\n",
    "region_by_zone = (\n",
    "    ctx.zones.set_index(\"grid_id\")[\"municipality_name\"]\n",
    "    .astype(str)\n",
    "    .map(municipality_to_region)\n",
    "    .fillna(\"Rest of Canton\")\n",
    "    .reindex(labels)\n",
    "    .to_numpy()\n",
    ")\n",
    "origin_region = region_by_zone[:, None]\n",
    "destination_region = region_by_zone[None, :]\n",
    "od_pkm_rows = []\n",
    "for origin, destination in key_pairs:\n",
    "    pair_mask = (origin_region == origin) & (destination_region == destination)\n",
    "    values = {mode: float(matrix[pair_mask].sum()) for mode, matrix in pkm_matrices.items()}\n",
    "    pair_total = sum(values.values())\n",
    "    if pair_total <= 0:\n",
    "        raise ValueError(f\"The selected OD relation has no PKM: {origin} to {destination}.\")\n",
    "    od_pkm_rows.append({\n",
    "        \"OD relation\": f\"{origin} to {destination}\",\n",
    "        \"total_pkm\": pair_total,\n",
    "        **{f\"{mode.lower().replace(' ', '_')}_pkm_share\": value / pair_total\n",
    "           for mode, value in values.items()},\n",
    "    })\n",
    "od_pkm_split = pd.DataFrame(od_pkm_rows)\n",
    "\n",
    "exports.save_outputs(\"1_5_baseline_modal_split\", tables={\n",
    "    \"corridor\": corridor_split,\n",
    "    \"od_trip_relations\": od_trip_split,\n",
    "    \"od_pkm_relations\": od_pkm_split,\n",
    "})\n",
    "print(f\"Stage-0 Forch corridor: {len(corridor_zone_ids)} internal zones\")\n",
    "print(\"Corridor trip-based and distance-weighted modal shares:\")\n",
