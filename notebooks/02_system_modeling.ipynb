   "source": [
    "_missing_setup = [name for name in (\"tmi\", \"p\", \"np\") if name not in globals()]\n",
    "if _missing_setup:\n",
    "    raise RuntimeError(\n",
    "        \"Run the notebook Setup cell before this cell. \"\n",
    "        f\"Missing setup values: {', '.join(_missing_setup)}\"\n",
    "    )\n",
    "MUNICIPALITY_FLOW_MAP = None\n",
    "if \"ctx\" not in globals() or ctx is None:\n",
    "    load_error = globals().get(\"TRANSPORT_LOAD_ERROR\")\n",
    "    status = globals().get(\"transport_status\")\n",
    "    unavailable = []\n",
    "    if status is not None and {\"present\", \"relative_path\"}.issubset(status.columns):\n",
    "        unavailable = status.loc[status[\"required\"] & ~status[\"present\"], \"relative_path\"].tolist()\n",
    "    if load_error:\n",
    "        reason = f\"Transport context load failed: {load_error}\"\n",
    "    elif unavailable:\n",
    "        reason = f\"Unavailable inputs: {', '.join(unavailable)}. Download the transport data with `git lfs pull` from the repository root.\"\n",
    "    else:\n",
    "        reason = \"Run the transport readiness cell and resolve any reported input issues.\"\n",
    "    display(HTML(\n",
