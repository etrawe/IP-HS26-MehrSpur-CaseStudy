   "source": [
    "# Added code to create a summary of 1.7\n",
    "\n",
    "_required_summary_inputs = (\"df_y1\", \"df_y40\", \"annual_comparison\", \"assignment_y1\", \"assignment_y40\")\n",
    "_missing_summary_inputs = [name for name in _required_summary_inputs if name not in globals()]\n",
    "if _missing_summary_inputs:\n",
    "    raise RuntimeError(\n",
    "        \"Run the Year 1 / Year 40 performance calculation cell immediately above first. \"\n",
    "        f\"Missing: {', '.join(_missing_summary_inputs)}\"\n",
    "    )\n",
    "T = \"--- Total / System Average ---\"\n",
    "car, pt, bike, walk = \"Car passengers\", \"Public Transport\", \"Bicycle\", \"Walking\"\n",
    "\n",
    "def row(name, unit, f, direction):\n",
    "    a, b = f(1), f(40)\n",
    "    return {\"Indicator\": name, \"Unit\": unit, \"Year 1\": a, \"Year 40\": b,\n",
    "            \"Change\": b - a, \"Change (%)\": 100 * (b - a) / a if a else float(\"nan\"),\n",
    "            \"Preferable\": direction}\n",
    "\n",
    "d = {1: df_y1, 40: df_y40}\n",
    "ann = annual_comparison\n",
    "links = {1: assignment_y1.links, 40: assignment_y40.links}\n",
    "\n",
    "rows = [\n",
    "    row(\"Total peak trips\", \"trips/peak hour\", lambda y: d[y].loc[T, \"Peak Trips\"], \"context (not a welfare score)\"),\n",
    "    row(\"Car trip share\", \"%\", lambda y: 100 * d[y].loc[car, \"Trip Share\"], \"lower (if the objective is less car use)\"),\n",
    "    row(\"PT trip share\", \"%\", lambda y: 100 * d[y].loc[pt, \"Trip Share\"], \"higher (if the objective is modal shift)\"),\n",
    "    row(\"Bicycle trip share\", \"%\", lambda y: 100 * d[y].loc[bike, \"Trip Share\"], \"higher (if the objective is modal shift)\"),\n",
    "    row(\"Walking trip share\", \"%\", lambda y: 100 * d[y].loc[walk, \"Trip Share\"], \"higher (if the objective is modal shift)\"),\n",
    "    row(\"Average journey time (all modes)\", \"min/trip\", lambda y: d[y].loc[T, \"Mode-choice journey time\"], \"lower\"),\n",
    "    row(\"Road congested time (peak)\", \"vehicle-h/peak hour\", lambda y: d[y].loc[T, \"Peak Road Congested Time (veh-h)\"], \"lower\"),\n",
    "    row(\"Car CO2 (peak)\", \"t/peak hour\", lambda y: d[y].loc[T, \"Peak Car CO2 (t)\"], \"lower\"),\n",
    "    row(\"Annual road congested time\", \"vehicle-h/year\", lambda y: ann.loc[T, f\"Year {y} Annual Road Congested Time (veh-h)\"], \"lower\"),\n",
    "    row(\"Annual car CO2\", \"t/year\", lambda y: ann.loc[T, f\"Year {y} Annual Car CO2 (t)\"], \"lower\"),\n",
    "    # case-specific extras\n",
    "    row(\"Links with V/C ≥ 1\", \"number of links\", lambda y: int((links[y][\"volume_capacity_ratio\"] >= 1).sum()), \"lower\"),\n",
    "    row(\"Maximum V/C\", \"ratio\", lambda y: links[y][\"volume_capacity_ratio\"].max(), \"lower\"),\n",
    "]\n",
    "indicators = pd.DataFrame(rows).set_index(\"Indicator\")\n",
    "exports.save_outputs(\"1_7_indicator_summary\", tables={\"\": indicators})\n",
    "display(indicators.style.format({\"Year 1\": \"{:,.2f}\", \"Year 40\": \"{:,.2f}\", \"Change\": \"{:+,.2f}\", \"Change (%)\": \"{:+.1f}%\"})) \n"
   ]
  },
