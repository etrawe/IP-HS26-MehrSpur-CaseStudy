    "    external_config = sf.external_flow_config()\n",
    "    configured = external_config[\"additional_trips_daily\"] if external_config[\"enabled\"] else 0.0\n",
    "    SECTION_CALIBRATION_TABLE = pd.DataFrame({\"Calibration\": {\n",
