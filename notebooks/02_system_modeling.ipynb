    "        spec[\"section_config\"] = project_section\n",
    "if \"ACTIVE_STAGE_SPECS\" in globals():\n",
    "    for stage, spec in list(ACTIVE_STAGE_SPECS.items()):\n",
    "        spec[\"section_config\"] = project_section\n",
    "\n",
    "print(\"Section configuration enabled for stage simulation.\")\n"
