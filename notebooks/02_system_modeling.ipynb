    "# Reuse the dashboard result when it matches; otherwise run the shared coupled assignment.\n",
    "def _get_coupled_assignment():\n",
    "    mode_result = ASSIGNMENT_MODE_STATE.get(\"result\")\n",
    "    if mode_result is None:\n",
    "        raise RuntimeError(\"Run the Stage 0 mode-choice calculation before identifying bottlenecks.\")\n",
    "\n",
    "    cache_key = (\n",
    "        id(ctx),\n",
    "        id(MEHRSPUR),\n",
    "        tuple(mode_result.cache_key),\n",
    "        tuple(sorted((key, repr(value)) for key, value in ASSIGNMENT_OPTIONS.items())),\n",
    "        float(tmi.DEFAULT_PASSTHROUGH_FRACTION),\n",
    "    )\n",
    "    cached = globals().get(\"_COUPLED_ASSIGNMENT_CACHE\")\n",
    "    if cached is not None and cached[0] == cache_key:\n",
    "        return cached[1]\n",
    "\n",
    "    result = COUPLED_ASSIGNMENT_STATE.get(\"result\")\n",
    "    matches_dashboard = (\n",
    "        result is not None\n",
    "        and COUPLED_ASSIGNMENT_STATE.get(\"context\") is ctx\n",
    "        and COUPLED_ASSIGNMENT_STATE.get(\"corridor\") is MEHRSPUR\n",
    "        and COUPLED_ASSIGNMENT_STATE.get(\"mode_cache_key\") == tuple(mode_result.cache_key)\n",
    "        and bool(result.diagnostics.get(\"modal_feedback\", False))\n",
    "        and tmi.assignment_settings_match(\n",
    "            result.diagnostics,\n",
    "            ASSIGNMENT_OPTIONS,\n",
    "            passthrough_fraction=tmi.DEFAULT_PASSTHROUGH_FRACTION,\n",
    "        )\n",
    "    )\n",
    "    if not matches_dashboard:\n",
    "        print(\"Calculating coupled assignment with shared settings...\")\n",
    "        result = tmi.run_coupled_corridor_assignment(\n",
    "            ctx,\n",
    "            MEHRSPUR,\n",
    "            mode_result,\n",
    "            passthrough_fraction=tmi.DEFAULT_PASSTHROUGH_FRACTION,\n",
    "            **tmi.assignment_solver_kwargs(ASSIGNMENT_OPTIONS, coupled=True),\n",
    "        )\n",
    "\n",
    "    globals()[\"_COUPLED_ASSIGNMENT_CACHE\"] = (cache_key, result)\n",
    "    return result\n",
    "\n",
    "\n",
    "coupled_assignment = _get_coupled_assignment()\n",
    "links = coupled_assignment.links\n",
    "\n",
    "cols = [\"edge_id\", \"highway\", \"flow_vehicles\", \"volume_capacity_ratio\", \"time_min\", \"assigned_speed_kph\"]\n",
    "cols = [column for column in cols if column in links]\n",
    "\n",
    "speed_threshold = links[\"assigned_speed_kph\"].quantile(0.25)\n",
    "bottleneck = links[\n",
    "    (links[\"volume_capacity_ratio\"] >= 1)\n",
    "    & (links[\"assigned_speed_kph\"] <= speed_threshold)\n",
    "]\n",
    "\n",
    "display(bottleneck.sort_values(\"time_min\", ascending=False)[cols].head(10))"
   ]
  },
